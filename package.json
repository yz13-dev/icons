{
  "name": "yz13-icons-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "validate": "bun scripts/validate.mjs",
    "preview": "bun scripts/preview.mjs",
    "build": "bun scripts/build.mjs",
    "typecheck": "tsc --project tsconfig.json",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "bun run validate && bun test && bun run lint && bun run format:check && bun run build && bun run typecheck"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@yz13/icons": "workspace:*",
    "oxfmt": "0.61.0",
    "oxlint": "1.82.0",
    "react": "^19",
    "rolldown": "^1.0.0",
    "svg-pathdata": "^9",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.0"
}
